# FJUSA Mod Bot configuration. Copy to .env and fill in:
#   cp .env.example .env && nano .env && chmod 600 .env
# .env is gitignored and kept out of the Docker image. Never commit it.
# ID lists are comma-separated Discord IDs (right-click > Copy ID).
# Tip: owners can change everything except secrets from Discord with !devset -
# those changes are saved and override the values below.

# --- Discord (required) -------------------------------------------------------
BOT_TOKEN=
COMMAND_PREFIX=!
BRAND_NAME=FJUSA Mod Bot
SERVER_DISPLAY_NAME=FJUSA
BRAND_COLOR=1D4ED8
# Leave empty to use the bot's avatar - run /setlogo once to make it the FJUSA logo.
LOGO_URL=

# --- Developer ----------------------------------------------------------------
# Shown in /help, the unapproved-server notice, and the "Message Developer" button.
DEVELOPER_NAME=xe2b
DEVELOPER_ID=1195765102725582968

# --- Access control -----------------------------------------------------------
# Owners bypass every tier and can never be moderated.
OWNER_IDS=1195765102725582968

# --- Tiered role system -------------------------------------------------------
# DEV > GOV > STAFF_DIRECTOR > STAFF   (each tier gets everything below it)
#
# STAFF:          warn, mute, tempmute, unmute, kick, tempban, unban, cases,
#                 casesearch, purge, slowmode, userinfo
# STAFF_DIRECTOR: ban (appealable), caseedit, casedelete, caseexport, modstats,
#                 lockdown, unlock + below
# GOV:            blacklist (final), globalban/unban/kick/mute/unmute, globalblacklist,
#                 globalannounce, globallockdown/unlock, settings, log/raid/warn
#                 config, backups + below
# DEV:            syscheck, debug, health, servers, addrole, setlogo + below (everything)
STAFF_ROLE_IDS=
STAFF_DIRECTOR_ROLE_IDS=
GOV_ROLE_IDS=
DEV_ROLE_IDS=
DEV_USER_IDS=

# --- Moderation ---------------------------------------------------------------
# Role /mute gives (deny Send Messages/Speak everywhere; keep it below the bot).
MUTE_ROLE_ID=
# Suggestions while typing a reason, separated by |. Free text still works.
REASON_PRESETS=Spamming|Harassment|NSFW content|Advertising|Trolling|Disrespecting staff|Breaking server rules|Ban evasion|Alt account|Exploiting

# --- Ban appeals --------------------------------------------------------------
# /tempban and /ban DMs get "Submit an appeal"; /blacklist and /globalban are final
# and get "Message Developer" instead. Leave APPEALS_CHANNEL_ID empty to turn it off.
APPEALS_CHANNEL_ID=
# Gets "A ban appeal has been sent to #appeals" with a jump link, plus the result.
APPEAL_ALERT_CHANNEL_ID=
# Who may vote Approve/Deny unban (roles in the appeals channel's server).
# Empty = Staff Director+.
APPEAL_VOTER_ROLE_IDS=
# Votes needed before a decision; the side with more votes wins (a tie waits).
APPEAL_MIN_VOTES=3
APPEAL_PING_VOTERS=true
# Who decisions come from: "The FJUSA Ban Team has reviewed your case..."
APPEAL_TEAM_NAME=FJUSA Ban Team
APPEAL_COOLDOWN_DAYS=7
# Link-only fallback when in-Discord appeals are off.
APPEAL_URL=

# --- Log channels -------------------------------------------------------------
# One channel ID per server in each list; the bot uses whichever is in the server the
# event happened in. Empty = /setlogchannel (Mod Logs) or /setserverlogchannel (rest).
# Mod Logs: cases, lockdowns, purges
MOD_LOGS_CHANNEL_IDS=
# Chat Logs: edited and deleted messages
CHAT_LOGS_CHANNEL_IDS=
# Join Logs: members joining and leaving
JOIN_LOGS_CHANNEL_IDS=
# Member Logs: role and nickname changes, bans and unbans
MEMBER_LOGS_CHANNEL_IDS=
# Voice Logs: voice joins, moves and leaves
VOICE_LOGS_CHANNEL_IDS=
# Server Logs: channel, role and invite changes
SERVER_LOGS_CHANNEL_IDS=
# Security Logs: raid and alt-account alerts
SECURITY_LOGS_CHANNEL_IDS=

# --- Server control -----------------------------------------------------------
APPROVED_GUILD_IDS=
LEAVE_UNAPPROVED_GUILDS=true
# Skipped by every global action (use for an appeals server).
GLOBAL_ACTION_EXEMPT_GUILD_IDS=
# Can never be moderated through the bot / can't use the bot at all.
PROTECTED_USER_IDS=
BLOCKED_USER_IDS=

# --- Database (required) ------------------------------------------------------
# Use the Postgres container NAME as the host, not localhost.
DATABASE_URL=postgresql://fjusa_bot:CHANGE_ME@fjusa-postgres:5432/fjusa
# Or set these four instead and the URL is built (and the password encoded) for you:
#POSTGRES_USER=fjusa_bot
#POSTGRES_PASSWORD=
#POSTGRES_HOST=fjusa-postgres
#POSTGRES_DB=fjusa

# --- Database tuning (optional) -----------------------------------------------
#DB_POOL_MIN_SIZE=1
#DB_POOL_MAX_SIZE=10
#DB_COMMAND_TIMEOUT=30
#DB_ACQUIRE_TIMEOUT=10
#DB_MAX_INACTIVE_CONNECTION_LIFETIME=300
#DB_CONNECT_MAX_ATTEMPTS=0
#DB_CONNECT_BACKOFF_START=1
#DB_CONNECT_BACKOFF_MAX=30
#DB_QUERY_MAX_RETRIES=2
#DB_CLOSE_TIMEOUT=10

# --- Logging (optional) -------------------------------------------------------
#LOG_LEVEL=info
#LOG_FORMAT=text
#LOG_LIBRARY_DEBUG=false

# --- Health endpoint (optional) -----------------------------------------------
#HEALTH_SERVER_ENABLED=true
#HEALTH_HOST=0.0.0.0
#HEALTH_PORT=8080

# --- Docker (optional) --------------------------------------------------------
#DOCKER_NETWORK=fjusa-net
#DOCKER_MEMORY_LIMIT=512M
