# Copy to .env and fill in. .env is gitignored and excluded from the Docker build
# context - never commit it or bake it into an image.
#
#   cp .env.example .env && nano .env

# --- Discord (required) -------------------------------------------------------
BOT_TOKEN=
COMMAND_PREFIX=!
BRAND_NAME=FJUSA Mod Bot
# Accent colour for embeds (hex, no #).
BRAND_COLOR=1D4ED8
# Used in ban DMs ("banned from all FJUSA servers") and the unapproved-server notice.
SERVER_DISPLAY_NAME=FJUSA
# Invite link to your appeals server. Ban DMs get an "Appeal your ban" button when set.
APPEAL_URL=
# Bot developer, shown in the unapproved-server notice and the /help footer.
DEVELOPER_NAME=xe2b
DEVELOPER_ID=1195765102725582968

# --- Access control -----------------------------------------------------------
# Comma-separated Discord user IDs. Owners bypass every tier and can never be moderated.
OWNER_IDS=1195765102725582968

# --- Tiered role system -------------------------------------------------------
# Four tiers, each inheriting every tier below it. OWNER_IDS bypass all tiers.
#
#   DEV  >  GOV  >  STAFF_DIRECTOR  >  STAFF
#
# STAFF:          warn, mute, tempmute, unmute, kick, tempban, unban,
#                 cases, casesearch, purge, slowmode, userinfo (+ right-click profile)
# STAFF_DIRECTOR: ban (permanent), caseedit, casedelete, caseexport, modstats,
#                 lockdown, unlock, lockdown roles, accept/deny appeals
#                 + all Staff commands
# GOV:            globalban/unban/kick/mute/unmute, globalblacklist, globalannounce,
#                 globallockdown, globalunlock, settings, set*channel, backups,
#                 raid + warn config + all Staff Director commands
# DEV:            debug, health, servers, addrole + everything
#
# Role-based tiers (comma-separated Discord role IDs - several servers' roles can
# all go in the same list):
STAFF_ROLE_IDS=
STAFF_DIRECTOR_ROLE_IDS=
GOV_ROLE_IDS=
# User-ID-based tier (comma-separated Discord user IDs, like OWNER_IDS):
DEV_USER_IDS=

# --- Appeals -------------------------------------------------------------------
# Channel where appeals from tempban DMs are posted for Staff Director+ to Accept or
# Deny with buttons. Permanent bans (/ban, /globalban) can never be appealed through
# the bot. Leave empty to turn in-Discord appeals off.
APPEALS_CHANNEL_ID=
# Days someone must wait to appeal again after a denial.
APPEAL_COOLDOWN_DAYS=7

# --- Reasons -------------------------------------------------------------------
# Suggestions shown while typing a reason. Separate with |. Free text still works.
REASON_PRESETS=Spamming|Harassment|NSFW content|Advertising|Trolling|Disrespecting staff|Breaking server rules|Ban evasion|Alt account|Exploiting

# --- Muting -------------------------------------------------------------------
# Role ID given by /mute and removed by /unmute (/tempmute uses Discord's timeout and
# needs no role). The role should deny Send Messages / Speak in every channel, and
# sit below the bot's own role.
MUTE_ROLE_ID=

# --- Server control -----------------------------------------------------------
APPROVED_GUILD_IDS=
LEAVE_UNAPPROVED_GUILDS=true

# Guilds exempt from global moderation actions (globalban, globalunban, globalkick,
# globalmute, globalunmute, the global blacklist, globalannounce, globallockdown). Use this for an Appeals server so a globally banned
# user can still join it to appeal. Normal per-guild commands still work inside
# exempt guilds. Comma-separated Discord guild IDs.
GLOBAL_ACTION_EXEMPT_GUILD_IDS=
PROTECTED_USER_IDS=
BLOCKED_USER_IDS=

# --- Database (required) ------------------------------------------------------
# Use the Postgres container NAME as the host - containers on the same Docker
# network resolve each other by name. Not localhost: inside the bot container
# that points at the bot itself.
DATABASE_URL=postgresql://fjusa_bot:CHANGE_ME@fjusa-postgres:5432/fjusa

# Alternative to DATABASE_URL: set these four and the URL is assembled from them
# (handy if the same values are already passed to the Postgres container).
# Special characters in the password are percent-encoded automatically.
#POSTGRES_USER=fjusa_bot
#POSTGRES_PASSWORD=
#POSTGRES_HOST=fjusa-postgres
#POSTGRES_PORT=5432
#POSTGRES_DB=fjusa

# --- Database tuning (optional) -----------------------------------------------
#DB_POOL_MIN_SIZE=1
#DB_POOL_MAX_SIZE=10
#DB_COMMAND_TIMEOUT=30
#DB_ACQUIRE_TIMEOUT=10
#DB_MAX_INACTIVE_CONNECTION_LIFETIME=300

# Startup retry. 0 = retry forever, which is the point: the bot waits for
# Postgres instead of exiting and crash-looping when it starts first.
#DB_CONNECT_MAX_ATTEMPTS=0
#DB_CONNECT_BACKOFF_START=1
#DB_CONNECT_BACKOFF_MAX=30

# Retries for a single query if Postgres blips while the bot is running.
#DB_QUERY_MAX_RETRIES=2
# Keep below the compose stop_grace_period.
#DB_CLOSE_TIMEOUT=10

# --- Logging (optional) -------------------------------------------------------
# LOG_LEVEL: critical | error | warning | info | debug
#LOG_LEVEL=info
# LOG_FORMAT: text (readable in docker logs) | json (for a log aggregator)
#LOG_FORMAT=text
# Include discord.py/asyncpg internals at DEBUG. Very noisy; off by default.
#LOG_LIBRARY_DEBUG=false

# --- Health endpoint (optional) -----------------------------------------------
# Serves /health and /ready for the Docker HEALTHCHECK and any monitoring on the
# Docker network. Not published to the host.
#HEALTH_SERVER_ENABLED=true
#HEALTH_HOST=0.0.0.0
#HEALTH_PORT=8080

# --- Docker (optional) ---------------------------------------------------------
# Existing Docker network shared with the Postgres container. Default fjusa-net.
#DOCKER_NETWORK=fjusa-net

# Memory ceiling for the bot container. Default 512M.
#DOCKER_MEMORY_LIMIT=512M

# --- Build metadata (optional) ------------------------------------------------
# Normally set as Docker build args rather than here.
#APP_VERSION=1.0.0
#GIT_COMMIT=
